{
  "name": "aether-office",
  "version": "0.4.1",
  "description": "A local-first workspace for coding agents: a 3D office for your Claude Code and Codex sessions, and a workbench to assign, review and verify their work.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "threejs",
    "local-first"
  ],
  "author": "haotool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haotool/aether-office.git"
  },
  "homepage": "https://github.com/haotool/aether-office#readme",
  "bugs": {
    "url": "https://github.com/haotool/aether-office/issues"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/aether/kernel.test.ts",
    "test:integration": "vitest run tests/aether/control.test.ts",
    "test:security": "vitest run tests/aether/security.test.ts",
    "test": "vitest run",
    "test:host-clis": "AETHER_HOST_CLIS=1 vitest run tests/aether/provider-compat.host-clis.test.ts",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/dev.ts --demo",
    "start": "node apps/control/dist/main.js",
    "runner": "tsx apps/runner/src/main.ts",
    "lint": "node scripts/check-boundaries.mjs && node scripts/check-design-tokens.mjs",
    "setup": "tsx scripts/setup.ts",
    "postinstall": "node scripts/prepare-pty.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks": "tsx scripts/hooks.ts",
    "runner:enroll": "tsx apps/runner/src/enroll.ts",
    "pair": "tsx apps/control/src/pair-cli.ts",
    "optimize:animals": "node scripts/optimize-animals.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "verification:report": "tsx scripts/verification-ledger.ts",
    "verification:check": "tsx scripts/verification-ledger.ts --check",
    "audit:gate": "node scripts/oss/audit-gate.mjs",
    "verify:clean": "node scripts/clean-room.mjs",
    "backup": "tsx scripts/backup.ts",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "notices": "node scripts/oss/third-party-notices.mjs",
    "notices:check": "node scripts/oss/third-party-notices.mjs --check && node scripts/oss/reuse-check.mjs",
    "quality": "node scripts/quality/score.mjs",
    "quality:report": "node scripts/quality/score.mjs --report",
    "quality:check": "node scripts/quality/score.mjs --check",
    "quality:release": "node scripts/quality/score.mjs --release",
    "quality:gates": "node scripts/quality/release/gates.mjs",
    "oss:check": "node scripts/oss/third-party-notices.mjs --check && node scripts/oss/reuse-check.mjs && node scripts/oss/readiness-check.mjs",
    "perf:mobile": "node --import tsx scripts/mobile-perf/run.ts",
    "protocol:regen": "node scripts/regenerate-codex-protocol.mjs",
    "perf:evidence": "node --import tsx scripts/mobile-perf/evidence.ts",
    "perf:record": "node scripts/mobile-perf/record.mjs",
    "ux:matrix": "playwright test --config e2e/ux-matrix/playwright.config.ts",
    "ux:summary": "node scripts/ux-matrix-summary.mjs"
  },
  "devDependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@agentclientprotocol/claude-agent-acp": "0.85.1",
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
