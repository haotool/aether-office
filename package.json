{
  "name": "aether-office",
  "version": "0.4.0-dev.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/aether/kernel.test.ts",
    "test:integration": "vitest run tests/aether/control.test.ts",
    "test:security": "vitest run tests/aether/security.test.ts",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/dev.ts --demo",
    "start": "node apps/control/dist/main.js",
    "runner": "tsx apps/runner/src/main.ts",
    "lint": "node scripts/check-boundaries.mjs",
    "setup": "tsx scripts/setup.ts",
    "postinstall": "node scripts/prepare-pty.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks": "tsx scripts/hooks.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
